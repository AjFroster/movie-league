# Copy to backend/.env and paste your own keys. Never commit backend/.env.
# TMDB — free key at https://www.themoviedb.org/settings/api (v4 read access token)
# Supplies: budget, gross (worldwide revenue), release_date, and the IMDb ID.
TMDB_API_KEY=your_tmdb_key_here

# OMDb — free key at https://www.omdbapi.com/apikey.aspx (1,000 requests/day)
# Supplies: imdb (the real IMDb rating) and rt_crit (Rotten Tomatoes critics).
OMDB_API_KEY=your_omdb_key_here

# CORS_ORIGIN=https://yourdomain.com
