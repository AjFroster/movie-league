# Copy to backend/.env and paste your own keys. Never commit backend/.env.
# TMDB — free key at https://www.themoviedb.org/settings/api (v4 read access token)
# Supplies: budget, gross (worldwide revenue), release_date, and the IMDb ID.
TMDB_API_KEY=your_tmdb_key_here

# OMDb — free key at https://www.omdbapi.com/apikey.aspx (1,000 requests/day)
# Supplies: imdb (the real IMDb rating) and rt_crit (Rotten Tomatoes critics).
OMDB_API_KEY=your_omdb_key_here

# MDBList - free key from https://mdblist.com Preferences (1,000 requests/day)
# Supplies all four rating inputs: imdb, letterboxd, rt_crit (tomatoes) and
# rt_aud (popcorn). This is the primary ratings source; OMDb is only a fallback.
MDBLIST_API_KEY=your_mdblist_key_here

# CORS_ORIGIN=https://yourdomain.com

# ---------------------------------------------------------------------------
# Accounts (Clerk)
#
# Leave these unset on a laptop. The app then runs in local mode: exactly one
# user, no sign-in, ownership still checked but always matching. It refuses to
# start that way unless the database is SQLite AND CORS_ORIGIN is localhost, so
# a deployment cannot silently end up with open access.
#
# Set them from https://dashboard.clerk.com -> your app -> API Keys.
# CLERK_ISSUER is the "Frontend API URL" / issuer, e.g.
#   https://clerk.your-app.lcl.dev   (development)
#   https://clerk.yourdomain.com     (production)
# The JWKS URL is derived from it; override only if Clerk gives you a different one.
# ---------------------------------------------------------------------------
# CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# CLERK_JWKS_URL=

# The frontend needs the publishable key in frontend/.env (NOT here) as:
#   VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
