# Secrets — never commit
backend/.env
.env
.env.local

# Python
backend/.venv/
__pycache__/
*.py[cod]
*.egg-info/

# Node
node_modules/
frontend/dist/
*.log

# WSL / Windows artifacts
*:Zone.Identifier

# Editor / OS
.DS_Store
.vscode/
.idea/

# Derived data
# Derived API cache — regenerates on demand, would churn on every enrich run
backend/data/api_cache.json
backend/data/api_cache.tmp
# Pre-migration rollback copies (Plan 02-02 writes league_data.json.bak)
backend/data/*.bak

# SQLite database (JSON export in backend/data/league_data.json is the readable copy)
backend/data/league.db
backend/data/league.db-wal
backend/data/league.db-shm

# Vendored agent skills (clerk/skills). skills-lock.json pins them; re-install with
# `npx skills add clerk/skills`. .claude/skills holds symlinks into .agents, which
# would be broken paths for anyone else.
.agents/
.claude/skills/

# Playwright output
frontend/test-results/
frontend/playwright-report/
